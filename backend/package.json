{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration:setup": "tsx test/setupTestDb.ts",
    "test:integration": "npm run test:integration:setup --silent && DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://$(whoami)@localhost:5432/relay_test}\" vitest run --config vitest.integration.config.ts",
    "test:e2e": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://$(whoami)@localhost:5432/relay_test}\" vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit --silent && npm run test:integration --silent && npm run test:e2e --silent",
    "inspect": "tsx scripts/inspect-athlete.ts",
    "verify-roster": "tsx scripts/verify-roster-integrity.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:real-roster": "tsx prisma/seedRealRoster.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "prisma": "^6.4.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
