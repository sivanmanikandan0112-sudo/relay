generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
}

enum SquadName {
  GIRLS
  BOYS
}

// Fresh/Ease back/Back off are score-driven bands; Return protocol and
// Injured are overrides that take precedence whenever an athlete has an
// active or recovering injury on file, regardless of what the score says.
enum ReadinessStatus {
  FRESH
  EASE_BACK
  BACK_OFF
  RETURN_PROTOCOL
  INJURED
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InviteType {
  ATHLETE
  COACH_TO_SCHOOL
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
  PREFER_NOT_TO_SAY
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(COACH)
  // Coach-only fields (meaningless for role=ATHLETE, same convention as
  // Athlete.gender being meaningless outside its own model): a coach may
  // optionally belong to one School, which shares roster visibility with
  // every other coach at the same school -- see lib/authz.ts.
  school        School?   @relation(fields: [schoolId], references: [id])
  schoolId      String?
  isSuperAdmin  Boolean   @default(false)
  // TOTP MFA (both roles, self-service, optional). totpSecretEncrypted
  // is AES-256-GCM ciphertext (never plaintext) -- see lib/crypto.ts.
  // "Pending" (secret generated but not yet confirmed) is represented by
  // totpSecretEncrypted set + totpEnabled still false; setup either
  // completes (verify-setup flips totpEnabled true) or is abandoned and
  // silently overwritten by a later setup attempt -- no separate state.
  totpSecretEncrypted String?
  totpEnabled          Boolean @default(false)
  mfaBackupCodes       MfaBackupCode[]
  // Optional, self-service, both roles -- links this account to a Google
  // identity so its owner can sign in without typing their password
  // (Google's own stable per-account "sub" claim, see lib/google.ts).
  // Does NOT replace passwordHash -- every account still has a real
  // password set at creation, Google is a second way in, not a
  // passwordless account. Linking never creates a new account and never
  // bypasses the athlete-invite flow; see routes/me.ts's
  // POST/DELETE /google-link and routes/auth.ts's POST /auth/google.
  googleId             String? @unique
  athlete       Athlete?
  notes         Note[]
  coachAthletes CoachAthlete[]
  invitesSent   Invite[]
  resetTokens   PasswordResetToken[]
  loginEvents   LoginEvent[]
  decidedJoinRequests SchoolJoinRequest[] // requests this coach approved/rejected -- see SchoolJoinRequest.decidedBy
  createdAt     DateTime  @default(now())
}

// One row per user per day (upserted in routes/auth.ts's buildSession --
// the single chokepoint both the plain-login and MFA-verify-completion
// paths already share), feeding the super admin's activity calendars.
// role is denormalized so the coach-logins calendar can filter/group
// without joining User. Nothing else in the app reads this table --
// pure activity-tracking, not part of auth itself.
model LoginEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      Role
  day       DateTime @db.Date // UTC calendar day, see lib/date.ts's dayKey()
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([role, day])
}

// One-time-use MFA recovery codes, issued 10 at a time when MFA setup is
// confirmed. Hashed with bcrypt (same primitive as passwordHash) --
// plaintext is returned to the client exactly once, at issuance, and
// never retrievable again.
model MfaBackupCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// An optional shared-visibility group for coaches. Deliberately NOT
// stamped anywhere on CoachAthlete/Invite -- roster visibility for a
// school-affiliated coach is always a live join through
// coach.schoolId (see lib/authz.ts getSchoolAthleteIds), not a snapshot
// taken at invite time. That means joining a school makes a coach's
// *entire* existing roster visible schoolwide immediately, with no
// backfill step, and leaving would (if that flow existing) do the
// reverse just as cleanly.
model School {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique // trim().toLowerCase() of name -- case-insensitive uniqueness enforced at the DB layer, race-safe
  location  String?
  coaches   User[]
  invites   Invite[]
  // Short, human-typeable code an athlete enters at /join to submit a
  // join request for this school -- deliberately not a long random
  // token like Invite.token, since a coach reads this one aloud/posts it
  // somewhere for a whole roster rather than sending it to one person.
  // Nullable rather than backfilled: every *new* school gets one at
  // creation (routes/schools.ts), and any pre-existing school gets one
  // lazily the first time lib/schoolDetail.ts's ensureJoinCode reads it
  // -- same "optional, self-healing" spirit as this repo's other
  // nullable-unique columns. Regenerating (coach-only) just replaces it;
  // the old code stops resolving but already-submitted requests are
  // untouched, since they don't store the code itself.
  joinCode      String?             @unique
  joinRequests  SchoolJoinRequest[]
  createdAt DateTime @default(now())
}

// An athlete-initiated, coach-approved counterpart to the coach-initiated
// Invite flow above: an athlete types a school's joinCode into the public
// /join page and submits their own proposed account details, which sit
// here as PENDING until any coach *at that school* approves or rejects
// them (schools already share roster visibility across their coaches --
// see lib/authz.ts -- so a shared pending-requests queue matches that
// same model, rather than inventing a single "owner" coach role).
//
// Deliberately does NOT create a User up front, even though the
// password is already chosen at request time -- an account only ever
// exists in this app once someone with authority has agreed to it (a
// coach sending an Invite, or a coach approving one of these), matching
// every other account-creation path. Approving materializes a real
// User + Athlete + CoachAthlete in one transaction, exactly mirroring
// inviteAccept.ts's own athlete-invite branch; rejecting just closes
// this row out, no account ever existed.
model SchoolJoinRequest {
  id              String            @id @default(cuid())
  school          School            @relation(fields: [schoolId], references: [id])
  schoolId        String
  firstName       String
  lastName        String
  username        String
  email           String
  passwordHash    String
  // Which of the two training squads this athlete expects to join --
  // the athlete's own guess, standing in for what a coach would normally
  // pick when sending a bulk Invite (see routes/invites.ts). Corrected
  // automatically once they set their real gender at first login, same
  // as any invited athlete's initial squad (see routes/me.ts's PATCH
  // /gender) -- this is only ever a starting point, not a final answer.
  squad           Squad             @relation(fields: [squadId], references: [id])
  squadId         String
  status          JoinRequestStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  decidedAt       DateTime?
  decidedBy       User?             @relation(fields: [decidedByUserId], references: [id])
  decidedByUserId String?

  @@index([schoolId, status])
}

// Many-to-many: an athlete can have more than one coach, and a coach has a
// roster of athletes assigned to them.
model CoachAthlete {
  id        String   @id @default(cuid())
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

// Either a coach inviting an athlete (type ATHLETE, requires squadId) or
// a coach inviting another coach into their school (type COACH_TO_SCHOOL,
// requires schoolId) -- one shared token/expiry/email-sending mechanism
// for both, branched in routes/inviteAccept.ts. Real email delivery goes
// through Resend when configured (see lib/email.ts); otherwise the coach
// copies/shares the accept link (built from `token`) directly. Either
// way, `status` only ever changes as a side effect of a real signup or
// a real accept -- there is no route to set it by hand.
model Invite {
  id          String       @id @default(cuid())
  email       String
  status      InviteStatus @default(PENDING)
  type        InviteType   @default(ATHLETE)
  invitedBy   User         @relation(fields: [invitedById], references: [id])
  invitedById String
  squad       Squad?       @relation(fields: [squadId], references: [id])
  squadId     String? // ATHLETE invites: which roster the accepted athlete joins; null on old pre-signup-flow invites
  school      School?      @relation(fields: [schoolId], references: [id])
  schoolId    String? // COACH_TO_SCHOOL invites: which school the accepting coach joins
  token       String       @unique
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([invitedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id           String              @id @default(cuid())
  name         SquadName           @unique
  athletes     Athlete[]
  invites      Invite[]
  joinRequests SchoolJoinRequest[]
}

model Athlete {
  id             String           @id @default(cuid())
  name           String
  gender         Gender?          // required at athlete login if unset; nullable until then
  squad          Squad            @relation(fields: [squadId], references: [id])
  squadId        String
  user           User?            @relation(fields: [userId], references: [id])
  userId         String?          @unique
  // Self-service, athlete-owned, off by default: the weekly ReadinessScore
  // is deliberately coach-only otherwise (see AthleteCheckin.tsx's own
  // copy), since an athlete who can see the number has an incentive to
  // inflate their daily check-in answers to keep it up. Adjustable anytime
  // from Profile -- a coach cannot set this on an athlete's behalf.
  shareReadinessWithAthlete Boolean @default(false)
  wellnessEntries WellnessEntry[]
  trainingLoads  TrainingLoad[]
  readinessScores ReadinessScore[]
  injuries       Injury[]
  notes          Note[]
  coaches        CoachAthlete[]
  createdAt      DateTime         @default(now())
}

model WellnessEntry {
  id         String   @id @default(cuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  date       DateTime @default(now())
  // Calendar day (UTC) this check-in belongs to -- see lib/date.ts's
  // dayKey(). One WellnessEntry per athlete per day, enforced below:
  // resubmitting the same day overwrites that day's row (an upsert
  // keyed on athleteId+day in routes/wellness.ts) instead of stacking a
  // new one, so a coach only ever sees an athlete's *final* answer for a
  // given day -- in the raw check-in list and in any trend built from it.
  day        DateTime @db.Date
  sleep      Int // 1-5, quality not hours
  soreness   Int // 1-5
  mood       Int // 1-5
  energy     Int // 1-5
  motivation Int // 1-5
  msg        String? // optional free-text note from the athlete

  @@unique([athleteId, day])
  @@index([athleteId, date])
}

model TrainingLoad {
  id            String   @id @default(cuid())
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  athleteId     String
  date          DateTime @default(now())
  runType       String // athlete-entered run title, e.g. "Easy 5mi" or "Tempo intervals"
  distanceMiles Float? // up to 2 decimal places, enforced client-side
  durationMin   Float // fractional minutes, converted from an HH:MM:SS input
  rpe           Int // rate of perceived exertion, 1-10
  load          Float // rpe * durationMin, session load

  @@index([athleteId, date])
}

model ReadinessScore {
  id          String          @id @default(cuid())
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  athleteId   String
  week        Int
  year        Int
  score       Int // 0-100
  status      ReadinessStatus
  summary     String
  // Snapshot of the athlete's days-of-history *at the moment this score was
  // computed* (lib/scoring.ts's computeReadinessBreakdown, floored) -- not
  // re-derived later from today's day-count, so a coach scrolling an
  // athlete's trend sees each past week's real confidence level instead of
  // every week retroactively relabeling itself "complete" the day the
  // athlete crosses the 28-day chronic window. Nullable: rows written
  // before this column existed simply don't get a confidence badge, rather
  // than a guessed value. See lib/status.ts's dataConfidence() (frontend)
  // and lib/math.ts's MIN_HISTORY_DAYS/CHRONIC_WINDOW_DAYS (backend).
  daysOfHistory Int?
  createdAt   DateTime        @default(now())

  @@unique([athleteId, week, year])
  @@index([week, year])
}

model Injury {
  id          String       @id @default(cuid())
  athlete     Athlete      @relation(fields: [athleteId], references: [id])
  athleteId   String
  description String
  status      InjuryStatus @default(ACTIVE)
  startDate   DateTime     @default(now())
  endDate     DateTime?

  @@index([athleteId])
}

model Note {
  id        String   @id @default(cuid())
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  body      String
  createdAt DateTime @default(now())

  @@index([athleteId])
}
