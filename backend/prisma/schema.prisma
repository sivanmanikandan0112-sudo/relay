generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
}

enum SquadName {
  GIRLS
  BOYS
}

// Fresh/Ease back/Back off are score-driven bands; Return protocol and
// Injured are overrides that take precedence whenever an athlete has an
// active or recovering injury on file, regardless of what the score says.
enum ReadinessStatus {
  FRESH
  EASE_BACK
  BACK_OFF
  RETURN_PROTOCOL
  INJURED
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InviteType {
  ATHLETE
  COACH_TO_SCHOOL
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
  PREFER_NOT_TO_SAY
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(COACH)
  // Coach-only fields (meaningless for role=ATHLETE, same convention as
  // Athlete.gender being meaningless outside its own model): a coach may
  // optionally belong to one School, which shares roster visibility with
  // every other coach at the same school -- see lib/authz.ts.
  school        School?   @relation(fields: [schoolId], references: [id])
  schoolId      String?
  isSuperAdmin  Boolean   @default(false)
  // TOTP MFA (both roles, self-service, optional). totpSecretEncrypted
  // is AES-256-GCM ciphertext (never plaintext) -- see lib/crypto.ts.
  // "Pending" (secret generated but not yet confirmed) is represented by
  // totpSecretEncrypted set + totpEnabled still false; setup either
  // completes (verify-setup flips totpEnabled true) or is abandoned and
  // silently overwritten by a later setup attempt -- no separate state.
  totpSecretEncrypted String?
  totpEnabled          Boolean @default(false)
  mfaBackupCodes       MfaBackupCode[]
  athlete       Athlete?
  notes         Note[]
  coachAthletes CoachAthlete[]
  invitesSent   Invite[]
  resetTokens   PasswordResetToken[]
  createdAt     DateTime  @default(now())
}

// One-time-use MFA recovery codes, issued 10 at a time when MFA setup is
// confirmed. Hashed with bcrypt (same primitive as passwordHash) --
// plaintext is returned to the client exactly once, at issuance, and
// never retrievable again.
model MfaBackupCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// An optional shared-visibility group for coaches. Deliberately NOT
// stamped anywhere on CoachAthlete/Invite -- roster visibility for a
// school-affiliated coach is always a live join through
// coach.schoolId (see lib/authz.ts getSchoolAthleteIds), not a snapshot
// taken at invite time. That means joining a school makes a coach's
// *entire* existing roster visible schoolwide immediately, with no
// backfill step, and leaving would (if that flow existing) do the
// reverse just as cleanly.
model School {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique // trim().toLowerCase() of name -- case-insensitive uniqueness enforced at the DB layer, race-safe
  location  String?
  coaches   User[]
  invites   Invite[]
  createdAt DateTime @default(now())
}

// Many-to-many: an athlete can have more than one coach, and a coach has a
// roster of athletes assigned to them.
model CoachAthlete {
  id        String   @id @default(cuid())
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

// Either a coach inviting an athlete (type ATHLETE, requires squadId) or
// a coach inviting another coach into their school (type COACH_TO_SCHOOL,
// requires schoolId) -- one shared token/expiry/email-sending mechanism
// for both, branched in routes/inviteAccept.ts. Real email delivery goes
// through Resend when configured (see lib/email.ts); otherwise the coach
// copies/shares the accept link (built from `token`) directly. Either
// way, `status` only ever changes as a side effect of a real signup or
// a real accept -- there is no route to set it by hand.
model Invite {
  id          String       @id @default(cuid())
  email       String
  status      InviteStatus @default(PENDING)
  type        InviteType   @default(ATHLETE)
  invitedBy   User         @relation(fields: [invitedById], references: [id])
  invitedById String
  squad       Squad?       @relation(fields: [squadId], references: [id])
  squadId     String? // ATHLETE invites: which roster the accepted athlete joins; null on old pre-signup-flow invites
  school      School?      @relation(fields: [schoolId], references: [id])
  schoolId    String? // COACH_TO_SCHOOL invites: which school the accepting coach joins
  token       String       @unique
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([invitedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id       String    @id @default(cuid())
  name     SquadName @unique
  athletes Athlete[]
  invites  Invite[]
}

model Athlete {
  id             String           @id @default(cuid())
  name           String
  gender         Gender?          // required at athlete login if unset; nullable until then
  squad          Squad            @relation(fields: [squadId], references: [id])
  squadId        String
  user           User?            @relation(fields: [userId], references: [id])
  userId         String?          @unique
  // Self-service, athlete-owned, off by default: the weekly ReadinessScore
  // is deliberately coach-only otherwise (see AthleteCheckin.tsx's own
  // copy), since an athlete who can see the number has an incentive to
  // inflate their daily check-in answers to keep it up. Adjustable anytime
  // from Profile -- a coach cannot set this on an athlete's behalf.
  shareReadinessWithAthlete Boolean @default(false)
  wellnessEntries WellnessEntry[]
  trainingLoads  TrainingLoad[]
  readinessScores ReadinessScore[]
  injuries       Injury[]
  notes          Note[]
  coaches        CoachAthlete[]
  createdAt      DateTime         @default(now())
}

model WellnessEntry {
  id         String   @id @default(cuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  date       DateTime @default(now())
  sleep      Int // 1-5, quality not hours
  soreness   Int // 1-5
  mood       Int // 1-5
  energy     Int // 1-5
  motivation Int // 1-5
  msg        String? // optional free-text note from the athlete

  @@index([athleteId, date])
}

model TrainingLoad {
  id            String   @id @default(cuid())
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  athleteId     String
  date          DateTime @default(now())
  runType       String // athlete-entered run title, e.g. "Easy 5mi" or "Tempo intervals"
  distanceMiles Float? // up to 2 decimal places, enforced client-side
  durationMin   Float // fractional minutes, converted from an HH:MM:SS input
  rpe           Int // rate of perceived exertion, 1-10
  load          Float // rpe * durationMin, session load

  @@index([athleteId, date])
}

model ReadinessScore {
  id          String          @id @default(cuid())
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  athleteId   String
  week        Int
  year        Int
  score       Int // 0-100
  status      ReadinessStatus
  summary     String
  createdAt   DateTime        @default(now())

  @@unique([athleteId, week, year])
  @@index([week, year])
}

model Injury {
  id          String       @id @default(cuid())
  athlete     Athlete      @relation(fields: [athleteId], references: [id])
  athleteId   String
  description String
  status      InjuryStatus @default(ACTIVE)
  startDate   DateTime     @default(now())
  endDate     DateTime?

  @@index([athleteId])
}

model Note {
  id        String   @id @default(cuid())
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  body      String
  createdAt DateTime @default(now())

  @@index([athleteId])
}
