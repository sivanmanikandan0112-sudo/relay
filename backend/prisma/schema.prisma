generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
}

enum SquadName {
  GIRLS
  BOYS
}

// Fresh/Ease back/Back off are score-driven bands; Return protocol and
// Injured are overrides that take precedence whenever an athlete has an
// active or recovering injury on file, regardless of what the score says.
enum ReadinessStatus {
  FRESH
  EASE_BACK
  BACK_OFF
  RETURN_PROTOCOL
  INJURED
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
  PREFER_NOT_TO_SAY
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(COACH)
  athlete       Athlete?
  notes         Note[]
  coachAthletes CoachAthlete[]
  invitesSent   Invite[]
  resetTokens   PasswordResetToken[]
  createdAt     DateTime  @default(now())
}

// Many-to-many: an athlete can have more than one coach, and a coach has a
// roster of athletes assigned to them.
model CoachAthlete {
  id        String   @id @default(cuid())
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

// A coach's bulk-invited email addresses. Real email delivery goes
// through Resend when configured (see lib/email.ts); otherwise the coach
// copies/shares the accept link (built from `token`) directly. Either
// way, `status` only ever changes as a side effect of a real signup --
// see routes/inviteAccept.ts, the public, unauthenticated flow an
// invited athlete uses to actually create their account. There is no
// route to set it by hand.
model Invite {
  id          String       @id @default(cuid())
  email       String
  status      InviteStatus @default(PENDING)
  invitedBy   User         @relation(fields: [invitedById], references: [id])
  invitedById String
  squad       Squad?       @relation(fields: [squadId], references: [id])
  squadId     String? // which roster the accepted athlete joins; null on old pre-signup-flow invites
  token       String       @unique
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([invitedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id       String    @id @default(cuid())
  name     SquadName @unique
  athletes Athlete[]
  invites  Invite[]
}

model Athlete {
  id             String           @id @default(cuid())
  name           String
  gender         Gender?          // required at athlete login if unset; nullable until then
  squad          Squad            @relation(fields: [squadId], references: [id])
  squadId        String
  user           User?            @relation(fields: [userId], references: [id])
  userId         String?          @unique
  wellnessEntries WellnessEntry[]
  trainingLoads  TrainingLoad[]
  readinessScores ReadinessScore[]
  injuries       Injury[]
  notes          Note[]
  coaches        CoachAthlete[]
  createdAt      DateTime         @default(now())
}

model WellnessEntry {
  id         String   @id @default(cuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  date       DateTime @default(now())
  sleep      Int // 1-5, quality not hours
  soreness   Int // 1-5
  mood       Int // 1-5
  energy     Int // 1-5
  motivation Int // 1-5
  msg        String? // optional free-text note from the athlete

  @@index([athleteId, date])
}

model TrainingLoad {
  id            String   @id @default(cuid())
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  athleteId     String
  date          DateTime @default(now())
  runType       String // athlete-entered run title, e.g. "Easy 5mi" or "Tempo intervals"
  distanceMiles Float? // up to 2 decimal places, enforced client-side
  durationMin   Float // fractional minutes, converted from an HH:MM:SS input
  rpe           Int // rate of perceived exertion, 1-10
  load          Float // rpe * durationMin, session load

  @@index([athleteId, date])
}

model ReadinessScore {
  id          String          @id @default(cuid())
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  athleteId   String
  week        Int
  year        Int
  score       Int // 0-100
  status      ReadinessStatus
  summary     String
  createdAt   DateTime        @default(now())

  @@unique([athleteId, week, year])
  @@index([week, year])
}

model Injury {
  id          String       @id @default(cuid())
  athlete     Athlete      @relation(fields: [athleteId], references: [id])
  athleteId   String
  description String
  status      InjuryStatus @default(ACTIVE)
  startDate   DateTime     @default(now())
  endDate     DateTime?

  @@index([athleteId])
}

model Note {
  id        String   @id @default(cuid())
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  body      String
  createdAt DateTime @default(now())

  @@index([athleteId])
}
