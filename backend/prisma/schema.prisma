generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
}

enum SquadName {
  GIRLS
  BOYS
}

// Fresh/Ease back/Back off are score-driven bands; Return protocol and
// Injured are overrides that take precedence whenever an athlete has an
// active or recovering injury on file, regardless of what the score says.
enum ReadinessStatus {
  FRESH
  EASE_BACK
  BACK_OFF
  RETURN_PROTOCOL
  INJURED
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(COACH)
  athlete       Athlete?
  notes         Note[]
  coachAthletes CoachAthlete[]
  invitesSent   Invite[]
  resetTokens   PasswordResetToken[]
  createdAt     DateTime  @default(now())
}

// Many-to-many: an athlete can have more than one coach, and a coach has a
// roster of athletes assigned to them.
model CoachAthlete {
  id        String   @id @default(cuid())
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

// A coach's bulk-invited email addresses. No real email delivery is wired
// up (this dev environment has no email provider configured) — accept/
// reject exist so the status can be exercised/tested without one.
model Invite {
  id          String       @id @default(cuid())
  email       String
  status      InviteStatus @default(PENDING)
  invitedBy   User         @relation(fields: [invitedById], references: [id])
  invitedById String
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([invitedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id       String    @id @default(cuid())
  name     SquadName @unique
  athletes Athlete[]
}

model Athlete {
  id             String           @id @default(cuid())
  name           String
  squad          Squad            @relation(fields: [squadId], references: [id])
  squadId        String
  user           User?            @relation(fields: [userId], references: [id])
  userId         String?          @unique
  wellnessEntries WellnessEntry[]
  trainingLoads  TrainingLoad[]
  readinessScores ReadinessScore[]
  injuries       Injury[]
  notes          Note[]
  coaches        CoachAthlete[]
  createdAt      DateTime         @default(now())
}

model WellnessEntry {
  id         String   @id @default(cuid())
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  athleteId  String
  date       DateTime @default(now())
  sleep      Int // 1-5, quality not hours
  soreness   Int // 1-5
  mood       Int // 1-5
  energy     Int // 1-5
  motivation Int // 1-5
  msg        String? // optional free-text note from the athlete

  @@index([athleteId, date])
}

model TrainingLoad {
  id            String   @id @default(cuid())
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  athleteId     String
  date          DateTime @default(now())
  runType       String // e.g. "Easy", "Tempo", "Long run", "Race"
  distanceMiles Float?
  durationMin   Int
  rpe           Int // rate of perceived exertion, 1-10
  load          Int // rpe * durationMin, session load

  @@index([athleteId, date])
}

model ReadinessScore {
  id          String          @id @default(cuid())
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  athleteId   String
  week        Int
  year        Int
  score       Int // 0-100
  status      ReadinessStatus
  summary     String
  createdAt   DateTime        @default(now())

  @@unique([athleteId, week, year])
  @@index([week, year])
}

model Injury {
  id          String       @id @default(cuid())
  athlete     Athlete      @relation(fields: [athleteId], references: [id])
  athleteId   String
  description String
  status      InjuryStatus @default(ACTIVE)
  startDate   DateTime     @default(now())
  endDate     DateTime?

  @@index([athleteId])
}

model Note {
  id        String   @id @default(cuid())
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  athleteId String
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  body      String
  createdAt DateTime @default(now())

  @@index([athleteId])
}
