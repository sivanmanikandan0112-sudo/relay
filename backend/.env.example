DATABASE_URL="postgresql://username@localhost:5432/relay_dev"
JWT_SECRET="change-me-in-production"
PORT=4000

# Required for MFA (TOTP secret encryption, lib/crypto.ts) -- unlike
# email, there's no simulate fallback, since storing a TOTP secret
# insecurely defeats the entire point. Generate with: openssl rand -hex 32
# (64 hex characters = 32 bytes, for AES-256-GCM). Use a different key in
# every environment; never commit a real one.
MFA_ENCRYPTION_KEY="generate-with-openssl-rand--hex-32"

# Email is optional. Leave RESEND_API_KEY unset for local dev/test --
# password resets and invite emails simulate (logged to the console, and
# the reset token/invite link comes back directly in the API response
# instead). Set these three in production to send real email through
# Resend, from a domain verified there -- see lib/email.ts.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Relay <admin@relaycoach.app>"
# FRONTEND_URL="https://relaycoach.app"
