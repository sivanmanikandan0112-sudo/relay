# Only needed when the frontend is deployed separately from the backend
# (different origin) -- e.g. two separate Railway services. Leave unset
# for local dev; vite.config.ts's proxy handles "/api" -> the local
# backend automatically.
VITE_API_BASE_URL="https://your-backend-service.up.railway.app/api"

# The same OAuth client ID as the backend's GOOGLE_CLIENT_ID -- not a
# secret, it's meant to be embedded in the frontend bundle. Unset, the
# "Sign in with Google" button just doesn't render (see lib/google.ts) --
# no broken button, the rest of the app works exactly the same without it.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
